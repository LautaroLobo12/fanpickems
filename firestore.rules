rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'lokolauti9@gmail.com';
    }
    
    // Users collection - users can only read/write their own data
    match /users/{userId} {
      allow read, write, create: if request.auth != null && request.auth.uid == userId;
    }
    
    // Teams collection - read-only for authenticated users, admin-only writes
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow write, create, delete: if isAdmin();
    }
    
    // Tournaments collection - read-only for authenticated users, admin-only writes
    match /tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow write, create, delete: if isAdmin();
      
      // Tournament picks subcollection
      match /picks/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null 
          && request.auth.uid == userId
          && validatePicksData(request.resource, tournamentId);
        allow update: if request.auth != null 
          && request.auth.uid == userId
          && (
               // EXEMPTION: If the core "bets" (picks) are NOT being changed, allow the update.
               // This covers points calculation, status flags, and timestamps.
               (request.resource.data.picks == resource.data.picks)
               || 
               // Standard Validation: If they ARE changing picks, enforce deadlines and schema.
               validatePicksData(request.resource, tournamentId)
             );
        allow delete: if false; // Prevent pick deletion
      }
    }
    
    // Public User Profiles - publicly readable, user can update their own public profile
    match /publicUserProfiles/{userId} {
      allow read: if request.auth != null;
      allow write, create: if request.auth != null && request.auth.uid == userId;
    }

    // Deny all other collections/documents
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Function to get tournament data
    function getTournament(tournamentId) {
      return get(/databases/$(database)/documents/tournaments/$(tournamentId));
    }

    // Helper function for basic structure validation
    function _isValidStructure(data, auth) {
      return data.keys().hasAll(['uid', 'picks', 'totalPoints', 'lastUpdated'])
        && data.uid is string
        && data.picks is map
        && data.totalPoints is number
        // Allow both existing timestamps and the incoming server timestamp
        && (data.lastUpdated is timestamp || data.lastUpdated == request.time)
        && data.uid == auth.uid;
    }

    // Helper function to check deadline for a specific stage
    function _isStageDeadlineValid(picks, stageName, tournamentStages, requestTime) {
      return !(picks[stageName] is list && picks[stageName].size() > 0) || (tournamentStages[stageName] != null && requestTime < tournamentStages[stageName].deadline);
    }
    
    // Helper function to check deadline for finals (string)
    function _isFinalsDeadlineValid(picks, tournamentStages, requestTime) {
      return !(picks.finals is string && picks.finals.size() > 0) || (tournamentStages.finals != null && requestTime < tournamentStages.finals.deadline);
    }

    // Main validation function
    function validatePicksData(newData, tournamentId) {
      return _isValidStructure(newData.data, request.auth)
        && _isStageDeadlineValid(newData.data.picks, 'playoffs', getTournament(tournamentId).data.stages, request.time)
        && _isStageDeadlineValid(newData.data.picks, 'playins', getTournament(tournamentId).data.stages, request.time)
        && _isStageDeadlineValid(newData.data.picks, 'semifinals', getTournament(tournamentId).data.stages, request.time)
        && _isFinalsDeadlineValid(newData.data.picks, getTournament(tournamentId).data.stages, request.time);
    }
  }
}