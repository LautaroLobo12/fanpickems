rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'lokolauti9@gmail.com';
    }
    
    // Users collection - users can only read/write their own data
    match /users/{userId} {
      allow read, write, create: if request.auth != null && request.auth.uid == userId;
    }
    
    // Teams collection - read-only for authenticated users, admin-only writes
    match /teams/{teamId} {
      allow read: if true;
      allow write, create, delete: if isAdmin();
    }
    
    // Tournaments collection - read-only for authenticated users, admin-only writes
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write, create, delete: if isAdmin();
      
      // Tournament picks subcollection
      match /picks/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null 
          && request.auth.uid == userId
          && validatePicksData(request.resource, tournamentId, {"data": {"picks": {}}});
        allow update: if request.auth != null 
          && request.auth.uid == userId
          && (
               // EXEMPTION: If the core "bets" (picks) are NOT being changed, allow the update.
               // This covers points calculation, status flags, and timestamps.
               (request.resource.data.picks == resource.data.picks)
               || 
               // Standard Validation: If they ARE changing picks, enforce deadlines and schema.
               validatePicksData(request.resource, tournamentId, resource)
             );
        allow delete: if false; // Prevent pick deletion
      }
    }
    
    // Public User Profiles - publicly readable, user can update their own public profile
    match /publicUserProfiles/{userId} {
      allow read: if request.auth != null;
      allow write, create: if request.auth != null && request.auth.uid == userId;
    }

    // Deny all other collections/documents
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Function to get tournament data
    function getTournament(tournamentId) {
      return get(/databases/$(database)/documents/tournaments/$(tournamentId));
    }

    // Helper function for basic structure validation
    function _isValidStructure(data, auth) {
      return data.keys().hasAll(['uid', 'picks', 'totalPoints', 'lastUpdated'])
        && data.uid is string
        && data.picks is map
        && data.totalPoints is number
        // Allow both existing timestamps and the incoming server timestamp
        && (data.lastUpdated is timestamp || data.lastUpdated == request.time)
        && data.uid == auth.uid;
    }

    // Helper function to check deadline for a specific stage
    function _isStageDeadlineValid(newData, stageName, tournamentStages, requestTime, oldData) {
      return 
        // If Stage doesn't exist in new data, it's valid (neutral)
        !(stageName in newData.data.picks)
        || 
        // If picks for this stage are identical to old picks, allow it (even if closed)
        (oldData != null && (stageName in oldData.data.picks) && newData.data.picks[stageName] == oldData.data.picks[stageName])
        ||
        // Otherwise, enforce deadline and existence in tournament
        (tournamentStages[stageName] != null && requestTime < tournamentStages[stageName].deadline);
    }
    
    // Main validation function
    function validatePicksData(newData, tournamentId, oldData) {
      let tournamentData = getTournament(tournamentId).data;
      let stages = tournamentData.stages;
      return _isValidStructure(newData.data, request.auth)
        // Hardcode common stage names since iteration is not supported in CEL
        && _isStageDeadlineValid(newData, 'Group Stage', stages, request.time, oldData)
        && _isStageDeadlineValid(newData, 'Play-Ins', stages, request.time, oldData)
        && _isStageDeadlineValid(newData, 'Finals Winner', stages, request.time, oldData)
        && _isStageDeadlineValid(newData, 'playoffs', stages, request.time, oldData)
        && _isStageDeadlineValid(newData, 'playins', stages, request.time, oldData)
        && _isStageDeadlineValid(newData, 'semifinals', stages, request.time, oldData)
        && _isStageDeadlineValid(newData, 'finals', stages, request.time, oldData);
    }
  }
}