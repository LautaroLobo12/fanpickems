---
// Simple navigation between screens
---

<nav class="navbar">
  <div class="nav-container">
    <div class="nav-brand">
      <a href="/picks">LCK Pickems</a>
    </div>

    <div class="nav-links">
      <a href="/picks" class="nav-link">Picks</a>
      <a href="/leaderboard" class="nav-link">Leaderboard</a>
      <button id="logout-btn" class="logout-btn">Logout</button>
    </div>

    <div id="user-info" class="user-info">
      <img
        id="user-avatar"
        class="user-avatar"
        alt="User Avatar"
        style="display: none;"
      />
      <span id="user-name" class="user-name"></span>
    </div>
  </div>
</nav>

<script src="./navigation.ts"></script>

<style is:global>
  .navbar {
    background: white;
    border-bottom: 1px solid #e0e0e0;
    padding: 0.75rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-brand a {
    font-size: 1.5rem;
    font-weight: 700;
    color: #333;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    color: #666;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: #007bff;
  }

  .logout-btn {
    background: #dc3545;
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .logout-btn:hover {
    background: #c82333;
  }

  .logout-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .user-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .user-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid #e0e0e0;
  }

  .user-name {
    font-size: 0.875rem;
    color: #666;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .nav-container {
      padding: 0 0.5rem;
      height: auto;
      min-height: 60px;
      flex-wrap: wrap;
    }

    .nav-brand {
      flex: 1;
    }

    .nav-links {
      gap: 0.5rem;
      order: 3;
      width: 100%;
      justify-content: center;
      padding: 0.5rem 0;
      border-top: 1px solid #e9ecef;
      margin-top: 0.5rem;
    }

    .nav-link {
      padding: 0.75rem 1rem;
      border-radius: 0.5rem;
      flex: 1;
      text-align: center;
      max-width: 120px;
    }

    .nav-text {
      font-size: 0.875rem;
    }

    .nav-user {
      order: 2;
    }

    .user-name {
      display: none;
    }

    .logout-btn {
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
    }
  }
</style>
