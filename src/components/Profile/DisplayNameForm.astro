---
---

<form id="display-name-form" class="form">
  <div class="form-group">
    <label for="displayName">Display Name</label>
    <input
      id="displayName"
      name="displayName"
      type="text"
      required
      minlength="2"
      maxlength="50"
      placeholder="Enter your display name"
    />
  </div>
  <button type="submit" class="btn-primary">Update Display Name</button>
  <p id="status" class="status-message" aria-live="polite"></p>
</form>

<script>
  import { auth } from '@/scripts/firebase';
  import { updateUserDisplayName } from '@/scripts/firestore';
  import { onAuthStateChanged, updateProfile } from 'firebase/auth';

  const form = document.getElementById('display-name-form') as HTMLFormElement;
  const statusEl = document.getElementById('status') as HTMLParagraphElement;
  const displayNameInput = document.getElementById('displayName') as HTMLInputElement;

  let currentUser: any = null;

  onAuthStateChanged(auth, (user) => {
    currentUser = user;
    if (user?.displayName) {
      displayNameInput.value = user.displayName;
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!currentUser) {
      statusEl.textContent = '❌ You must be signed in.';
      statusEl.className = 'status-message error';
      return;
    }

    const displayName = (new FormData(form).get('displayName') as string)?.trim();

    if (!displayName || displayName.length < 2) {
      statusEl.textContent = '❌ Display name must be at least 2 characters.';
      statusEl.className = 'status-message error';
      return;
    }

    statusEl.textContent = '⏳ Saving...';
    statusEl.className = 'status-message loading';

    try {
      // Update Firestore
      await updateUserDisplayName(currentUser.uid, displayName);

      // Update Firebase Auth profile
      await updateProfile(currentUser, { displayName });

      statusEl.textContent = '✅ Display name updated successfully!';
      statusEl.className = 'status-message success';
      
      // Clear the message after 3 seconds
      setTimeout(() => {
        statusEl.textContent = '';
        statusEl.className = 'status-message';
      }, 3000);
    } catch (error) {
      console.error('Error updating display name:', error);
      statusEl.textContent = '❌ Failed to update display name. Try again.';
      statusEl.className = 'status-message error';
    }
  });
</script>

<style>
  .form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  label {
    font-weight: 600;
    font-size: 1rem;
    color: #333;
  }

  input {
    padding: 0.75rem;
    border: 1px solid #ced4da;
    border-radius: 0.375rem;
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  input:focus {
    outline: none;
    border-color: #007bff;
    box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
  }

  .btn-primary {
    background: #dc3545;
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .btn-primary:hover {
    background-color: #0056b3;
  }

  .btn-primary:active {
    background-color: #004085;
  }

  .btn-primary:disabled {
    background-color: #6c757d;
    cursor: not-allowed;
  }

  .status-message {
    padding: 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.9rem;
    margin: 0;
    text-align: center;
  }

  .status-message:empty {
    display: none;
  }

  .status-message.success {
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .status-message.error {
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  .status-message.loading {
    background-color: #e2e3e5;
    color: #383d41;
    border: 1px solid #d6d8db;
  }

  @media (max-width: 768px) {
    .btn-primary {
      width: 100%;
    }
  }
</style>