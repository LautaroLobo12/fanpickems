---
// Admin page for data initialization - ADMIN ONLY
import Layout from "../layouts/Layout.astro";
import AuthGuard from "../components/AuthGuard/AuthGuard.astro";
---

<Layout title="LCK Pickems - Admin Setup">
  <AuthGuard>
    <div class="admin-container">
      <div id="admin-check" class="admin-check">
        <p>Checking admin access...</p>
      </div>

      <div id="admin-content" class="admin-content" style="display: none;">
        <h1>Admin Setup</h1>
        <p>Initialize sample data for development</p>

        <div class="admin-actions">
          <button id="init-teams" class="admin-btn">Initialize Teams</button>
          <button id="init-tournament" class="admin-btn"
            >Initialize Tournament</button
          >
          <button id="init-all" class="admin-btn primary"
            >Initialize All Data</button
          >
        </div>

        <div id="status" class="status-area"></div>
      </div>

      <div id="access-denied" class="access-denied" style="display: none;">
        <h1>Access Denied</h1>
        <p>You don't have permission to access this page.</p>
        <a href="/picks">Return to Home</a>
      </div>
    </div>
  </AuthGuard>
</Layout>

<script src="../scripts/admin-page.ts"></script>

<style>
  .admin-container {
    max-width: 600px;
    margin: 2rem auto;
    padding: 2rem;
    text-align: center;
  }

  .admin-check {
    padding: 2rem;
    color: #6c757d;
  }

  .access-denied {
    padding: 2rem;
    color: #721c24;
    background: #f8d7da;
    border: 1px solid #f5c6cb;
    border-radius: 0.5rem;
    margin: 2rem 0;
  }

  .access-denied a {
    color: #721c24;
    text-decoration: underline;
  }

  .admin-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin: 2rem 0;
    flex-wrap: wrap;
  }

  .admin-btn {
    padding: 1rem 2rem;
    border: none;
    border-radius: 0.5rem;
    background: #6c757d;
    color: white;
    cursor: pointer;
    font-size: 1rem;
    transition: background-color 0.2s;
  }

  .admin-btn:hover {
    background: #5a6268;
  }

  .admin-btn.primary {
    background: #007bff;
  }

  .admin-btn.primary:hover {
    background: #0056b3;
  }

  .status-area {
    margin-top: 2rem;
    min-height: 3rem;
  }

  .status {
    padding: 1rem;
    border-radius: 0.375rem;
    margin: 0.5rem 0;
  }

  .status.info {
    background: #d1ecf1;
    color: #0c5460;
    border: 1px solid #bee5eb;
  }

  .status.success {
    background: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .status.error {
    background: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  @media (max-width: 768px) {
    .admin-actions {
      flex-direction: column;
      align-items: center;
    }

    .admin-btn {
      width: 100%;
      max-width: 300px;
    }
  }
</style>
