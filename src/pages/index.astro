---
// Login page
import { Image } from "astro:assets";
import LoginForm from "../components/LoginForm/LoginForm.astro";
import Layout from "../layouts/Layout.astro";
import app_logo from "../assets/app_logo.png";
import preview_img from "../assets/preview.png";
---

<Layout title="LCK Pickems - Login">
  <div class="login-container">
    <Image src={app_logo} alt="LCK Fan Pickems" class="login-logo" />
    <p>Login to make your tournament predictions</p>

    <Image src={preview_img} alt="App Preview" class="app-preview" />

    <LoginForm />
  </div>
</Layout>

<script>
  import { waitForAuth, handleTokenInUrl } from "../scripts/auth.js";

  // Check for custom token from Discord redirect first
  handleTokenInUrl().then((result) => {
    if (result?.success) {
      window.location.href = "/picks";
    }
  });

  // Check if user is already authenticated and redirect to picks page
  waitForAuth().then((user) => {
    if (user) {
      window.location.href = "/picks";
    }
  });
</script>

<style>
  .login-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem;
    text-align: center;
  }

  h1 {
    color: #333;
    margin-bottom: 0.5rem;
    font-size: 2.5rem;
  }

  p {
    color: #666;
    margin-bottom: 2rem;
    font-size: 1.1rem;
  }

  .login-container .login-logo {
    max-width: 700px; /* Adjust as needed */
    height: auto;
    margin-bottom: 2rem; /* Add some space below the logo */
  }

  .app-preview {
    width: 50%;
    max-width: 650px;
    margin-bottom: 2rem;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    border: 1px solid #ddd;
  }

  @media (max-width: 768px) {
    .login-container .login-logo {
      max-width: 380px;
    }
    .app-preview {
      width: 100%;
      max-width: 650px;
    }
  }
</style>
