---
// Login page
import { Image } from "astro:assets";
import LoginForm from "../components/LoginForm/LoginForm.astro";
import Layout from "../layouts/Layout.astro";
import app_logo from "../assets/app_logo.png";
---

<Layout title="LCK Pickems - Login">
  <div class="login-container">
    <Image src={app_logo} alt="LCK Fan Pickems" class="login-logo" />
    <p>Login to make your tournament predictions</p>
    <LoginForm />
  </div>
</Layout>

<script>
  import { waitForAuth } from "../scripts/auth.js";

  // Check if user is already authenticated and redirect to picks page
  waitForAuth().then((user) => {
    if (user) {
      window.location.href = "/picks";
    }
  });
</script>

<style>
  .login-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem;
    text-align: center;
  }

  h1 {
    color: #333;
    margin-bottom: 0.5rem;
    font-size: 2.5rem;
  }

  p {
    color: #666;
    margin-bottom: 2rem;
    font-size: 1.1rem;
  }

  .login-container .login-logo {
    max-width: 700px; /* Adjust as needed */
    height: auto;
    margin-bottom: 2rem; /* Add some space below the logo */
  }

  @media (max-width: 768px) {
    .login-container .login-logo {
      max-width: 380px;
    }
  }
</style>
